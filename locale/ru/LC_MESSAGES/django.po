msgstr "Данные QR"

msgid "API №1 URL"
msgstr "API №1 URL"

msgid "Mock complete signing"
msgstr "Тестовое завершение подписания"

msgid "Selected method"
msgstr "Выбранный способ"

msgid "Continue signing in eGov Mobile. You may need to confirm the signing request in the mobile app."
msgstr "Продолжите подписание в eGov Mobile. Возможно, потребуется подтвердить запрос на подписание в мобильном приложении."

msgid "Sign with eGov Mobile"
msgstr "Подписать через eGov Mobile"

msgid "SMS code has been sent to your phone number."
msgstr "SMS-код отправлен на ваш номер телефона."

msgid "Session status"
msgstr "Статус сессии"

msgid "Code expires at"
msgstr "Код действует до"

msgid "Attempts"
msgstr "Попытки"

msgid "If the code is incorrect, wait before trying again."
msgstr "Если код неверный, подождите перед следующей попыткой."

msgid "Confirm that you reviewed the document and request an SMS verification code."
msgstr "Подтвердите, что вы ознакомились с документом, и запросите SMS-код подтверждения."

msgid "I confirm that I have reviewed the document, agree with its content, and confirm signing this document using an SMS verification code."
msgstr "Я подтверждаю, что ознакомился с документом, согласен с его содержанием и подтверждаю подписание этого документа с помощью SMS-кода."

msgid "Send SMS code"
msgstr "Отправить SMS-код"

msgid "To sign this document using ECP, make sure NCALayer is installed and running on your computer."
msgstr "Чтобы подписать документ с помощью ЭЦП, убедитесь, что NCALayer установлен и запущен на вашем компьютере."

msgid "After clicking the button, choose your ECP key and confirm signing in NCALayer."
msgstr "После нажатия кнопки выберите ключ ЭЦП и подтвердите подписание в NCALayer."

msgid "Sign with ECP"
msgstr "Подписать через ЭЦП"

msgid "Enter code"
msgstr "Введите код"

msgid "Enter the code sent to your phone number."
msgstr "Введите код, отправленный на ваш номер телефона."

msgid "SMS code"
msgstr "SMS-код"

msgid "Confirm and sign"
msgstr "Подтвердить и подписать"

msgid "Document signers | QolQoyu"
msgstr "Подписанты документа | QolQoyu"

msgid "Signing control"
msgstr "Управление подписанием"

msgid "Document signers"
msgstr "Подписанты документа"

msgid "Document status"
msgstr "Статус документа"

msgid "Back to documents"
msgstr "Назад к документам"

msgid "Total signers"
msgstr "Всего подписантов"

msgid "Generated from document parties"
msgstr "Созданы из сторон документа"

msgid "Signing methods"
msgstr "Способы подписания"

msgid "Available for invited signers"
msgstr "Доступны для приглашенных подписантов"

msgid "Access links"
msgstr "Ссылки доступа"

msgid "Secure"
msgstr "Защищено"

msgid "Each signer receives a personal link"
msgstr "Каждый подписант получает персональную ссылку"

msgid "Signing route"
msgstr "Маршрут подписания"

msgid "These signers were created automatically from the document data."
msgstr "Эти подписанты были автоматически созданы из данных документа."

msgid "Create SMS link"
msgstr "Создать SMS-ссылку"

msgid "Already signed"
msgstr "Уже подписано"

msgid "No generated signers"
msgstr "Нет созданных подписантов"

msgid "No signers were created from this document"
msgstr "Из этого документа не были созданы подписанты"

msgid "Go back to the document filling step and make sure the template has signer parties with full name, IIN/BIN, phone and signing method fields."
