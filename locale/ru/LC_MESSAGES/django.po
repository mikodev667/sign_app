msgid "Online document signing platform"
msgstr "Платформа онлайн-подписания документов"

msgid "Prepare, send and sign documents online"
msgstr "Подготавливайте, отправляйте и подписывайте документы онлайн"

msgid "Sign-App helps organizations upload DOCX templates, generate documents, add signers and manage the signing process through secure online links."
msgstr "Sign-App помогает организациям загружать DOCX-шаблоны, создавать документы, добавлять подписантов и управлять процессом подписания через защищённые онлайн-ссылки."

msgid "View templates"
msgstr "Посмотреть шаблоны"

msgid "Create account"
msgstr "Создать аккаунт"

msgid "Sign in"
msgstr "Войти"

msgid "Signing workflow"
msgstr "Процесс подписания"

msgid "Upload DOCX template"
msgstr "Загрузить DOCX-шаблон"

msgid "Add variables like"
msgstr "Добавьте переменные, например"

msgid "and"
msgstr "и"

msgid "Generate a document from the selected template."
msgstr "Создайте документ на основе выбранного шаблона."

msgid "Add signers"
msgstr "Добавьте подписантов"

msgid "Specify signer name, IIN, phone number and signing order."
msgstr "Укажите имя подписанта, ИИН, номер телефона и порядок подписания."

msgid "Send secure link"
msgstr "Отправьте защищённую ссылку"

msgid "The signer opens the link, reviews the document and confirms signing."
msgstr "Подписант открывает ссылку, просматривает документ и подтверждает подписание."

msgid "Template-based documents"
msgstr "Документы на основе шаблонов"

msgid "Upload reusable DOCX templates and automatically fill document fields."
msgstr "Загружайте многоразовые DOCX-шаблоны и автоматически заполняйте поля документа."

msgid "Secure signer links"
msgstr "Защищённые ссылки для подписантов"

msgid "Send each signer a personal secure link for document review and confirmation."
msgstr "Отправляйте каждому подписанту персональную защищённую ссылку для просмотра и подтверждения документа."

msgid "Signing history"
msgstr "История подписания"

msgid "Track document status, signer actions and signing progress."
msgstr "Отслеживайте статус документа, действия подписантов и прогресс подписания."

msgid "Start with templates and documents"
msgstr "Начните с шаблонов и документов"

msgid "The MVP currently focuses on document templates, generated documents and the basic signing workflow. Later we can add eGov Mobile signing, SMS confirmation, organizations, audit log and protected file storage."
msgstr "Текущий MVP сосредоточен на шаблонах документов, созданных документах и базовом процессе подписания. Позже можно добавить подписание через eGov Mobile, SMS-подтверждение, организации, журнал аудита и защищённое хранение файлов."

