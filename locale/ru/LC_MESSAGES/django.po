msgstr "Ключ переменной пустой"

msgid "Sign document | QolQoyu"
msgstr "Подписать документ | QolQoyu"

msgid "Secure signing"
msgstr "Безопасное подписание"

msgid "Document signing"
msgstr "Подписание документа"

msgid "Review the document, check your details and complete signing using the selected method."
msgstr "Проверьте документ, свои данные и завершите подписание выбранным способом."

msgid "Signing status"
msgstr "Статус подписания"

msgid "Open PDF"
msgstr "Открыть PDF"

msgid "Please make sure the document content is correct before confirming the signature."
msgstr "Убедитесь, что содержание документа корректно, перед подтверждением подписи."

msgid "Document file is not rendered yet."
msgstr "Файл документа еще не сформирован."

msgid "Document hash"
msgstr "Хэш документа"

msgid "Signer"
msgstr "Подписант"

msgid "IIN"
msgstr "ИИН"

msgid "Document already signed"
msgstr "Документ уже подписан"

msgid "This document has already been signed."
msgstr "Этот документ уже был подписан."

msgid "Signed at"
msgstr "Подписано"

