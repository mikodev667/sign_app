msgstr "Загрузить DOCX-шаблон | QolQoyu"

msgid "DOCX upload"
msgstr "Загрузка DOCX"

msgid "Upload DOCX Template"
msgstr "Загрузить DOCX-шаблон"

msgid "Upload a DOCX file with variables and turn it into a reusable document template."
msgstr "Загрузите DOCX-файл с переменными и превратите его в многоразовый шаблон документа."

msgid "Before uploading"
msgstr "Перед загрузкой"

msgid "Make sure your DOCX template is prepared correctly."
msgstr "Убедитесь, что ваш DOCX-шаблон подготовлен правильно."

msgid "Use DOCX format"
msgstr "Используйте формат DOCX"

msgid "Only DOCX files should be uploaded as templates."
msgstr "В качестве шаблонов следует загружать только DOCX-файлы."

msgid "Add variables"
msgstr "Добавьте переменные"

msgid "Use variables like"
msgstr "Используйте переменные, например"

msgid "inside the document."
msgstr "внутри документа."

msgid "Keep names clear"
msgstr "Используйте понятные названия"

msgid "Use readable variable names so the document can be filled easily."
msgstr "Используйте читаемые названия переменных, чтобы документ было легко заполнять."

msgid "Example"
msgstr "Пример"

msgid "Upload form"
msgstr "Форма загрузки"

msgid "Template file"
msgstr "Файл шаблона"

