POSTGRES_DB=sign_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_EXTERNAL_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=signappminio
MINIO_SECRET_KEY=signappminio123
MINIO_BUCKET=sign-app-documents
MINIO_SECURE=False
MINIO_ROOT_USER=signappminio
MINIO_ROOT_PASSWORD=signappminio123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9002
MINIO_DEFAULT_RETENTION_DAYS=30

LAWVISION_API_KEY=
LAWVISION_API_URL=https://lawvision.kz/api/v1
LAWVISION_TIMEOUT_SECONDS=90

LEDGER_ENABLED=False
LEDGER_API_URL=https://blockchain.kaznu.kz/v1
LEDGER_API_KEY_FILE=/etc/sign-ledger-client/api-key
# Leave empty to use the system certificate store. Set only if a custom CA is provided.
LEDGER_CA_CERT_FILE=
LEDGER_CLIENT_CERT_FILE=/etc/sign-ledger-client/client.crt
LEDGER_CLIENT_KEY_FILE=/etc/sign-ledger-client/client.key
LEDGER_TIMEOUT_SECONDS=60
LEDGER_ACTOR=sign_app
LEDGER_EXTERNAL_ID_PREFIX=contract

# Set this only when your PostgreSQL server requires a specific SSL mode.
# Common values: disable, allow, prefer, require, verify-ca, verify-full.
# POSTGRES_SSLMODE=prefer

# Logging. By default logs go to console/systemd journal. Set DJANGO_LOG_FILE
# only when the target directory exists and is writable by the Django service.
DJANGO_LOG_LEVEL=INFO
ADMISSIONS_LOG_LEVEL=INFO
DJANGO_LOG_FILE=

# Required only for legacy .doc templates.
# Example on Windows:
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
LIBREOFFICE_PATH=

# Optional. Used for PDF placeholder overlays, especially for Cyrillic/Kazakh text.
# PDF_OVERLAY_FONT_PATH=C:\Windows\Fonts\arial.ttf
PDF_OVERLAY_FONT_PATH=

# Public base URL used in generated verification QR codes.
# Example: https://qolqoyu.farabi.university
PUBLIC_SITE_URL=

# Optional MSSQL mirror for admissions data. The docker-compose.yml file can
# run this database locally and expose it only on 127.0.0.1.
MSSQL_PID=Express
MSSQL_SA_PASSWORD=ChangeMe_Mssql2026!
MSSQL_HOST_PORT=14330
ADMISSIONS_MSSQL_ENABLED=False
ADMISSIONS_MSSQL_REQUIRED=False
ADMISSIONS_MSSQL_ENGINE=mssql
ADMISSIONS_MSSQL_NAME=sign_app_admissions
ADMISSIONS_MSSQL_USER=sign_app_admissions
ADMISSIONS_MSSQL_PASSWORD=ChangeMe_Mssql2026!
ADMISSIONS_MSSQL_HOST=127.0.0.1
ADMISSIONS_MSSQL_PORT=14330
ADMISSIONS_MSSQL_DRIVER=ODBC Driver 18 for SQL Server
ADMISSIONS_MSSQL_EXTRA_PARAMS=TrustServerCertificate=yes
ADMISSIONS_ASYNC_RENDER_ENABLED=False
